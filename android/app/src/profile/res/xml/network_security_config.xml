<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile builds: same as release (no cleartext).
  Profile is closer to production; use HTTPS backends when profiling.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">getcoparentes.app</domain>
        <domain includeSubdomains="true">railway.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
