# Coparentes API base URL (compile-time dart-define)
#
# Local backend:
#   COPARENTES_API_BASE_URL=http://localhost:3000/api
#
# Production (verified live May 2026):
#   COPARENTES_API_BASE_URL=https://coparentes-backend-production.up.railway.app/api
#
# Netlify: set COPARENTES_API_BASE_URL in Site → Environment variables.
# Flutter run:
#   flutter run -d chrome --dart-define=COPARENTES_API_BASE_URL=http://localhost:3000/api

COPARENTES_API_BASE_URL=https://coparentes-backend-production.up.railway.app/api
